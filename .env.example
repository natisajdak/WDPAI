# Skopiuj do .env (cp .env.example .env) i uzupełnij. Plik .env nie trafia do repozytorium.

# Aplikacja
APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8080
APP_DEFAULT_LOCALE=pl

# Porty na hoście
WEB_PORT=8080
MAILPIT_UI_PORT=8025
DB_FORWARD_PORT=5433

# Baza danych (DB_HOST to nazwa usługi z docker-compose.yml)
DB_HOST=db
DB_PORT=5432
DB_NAME=cargo
DB_USER=cargo
DB_PASSWORD=change_me

# Sesja (SESSION_SECURE=1 na produkcji z HTTPS)
SESSION_NAME=cargo_sid
SESSION_SECURE=0
SESSION_LIFETIME=7200

# Poczta (lokalnie Mailpit, bez uwierzytelniania)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@cargo.local
MAIL_FROM_NAME=Cargo

# Uploady i CRON
UPLOAD_MAX_BYTES=5242880
UDT_REMINDER_DAYS=30,7
