APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_DEFAULT_LOCALE=pl

POSTGRES_DB=cargo
POSTGRES_USER=cargo_owner
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5433

DB_HOST=db
DB_PORT=5432
DB_NAME=cargo
DB_USER=cargo_app
DB_PASSWORD=secret_app

SESSION_NAME=cargo_sid
SESSION_SECURE=false
SESSION_LIFETIME=7200

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@cargo.local
MAIL_FROM_NAME=Cargo

UPLOAD_MAX_BYTES=5242880

PGADMIN_CONTAINER_NAME=cargo-pgadmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050