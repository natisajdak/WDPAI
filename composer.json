{
  "name": "cargo/cargo",
  "description": "System zarządzania flotą wózków widłowych: rezerwacje, kontrola przed jazdą, usterki, badania UDT.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
